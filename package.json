{
  "name": "agenttools",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~54.0.36",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.16.0",
    "react": "^19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "deploy:web": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-web.ps1",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.5": true
  }
}
